---
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';
import Icon from '../components/Icon.astro';
import { company } from '../data/company';

interface Props {
  title?: string;
  description?: string;
  solidHeader?: boolean;
}

const {
  title = `${company.name} – CNC alkatrészgyártás Egerben`,
  description = `${company.tagline}. CNC marás, esztergálás, huzalszikra-forgácsolás és menethengerlés Egerben.`,
  solidHeader = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
const nav = [
  { href: `${home}#rolunk`, label: 'Rólunk' },
  { href: `${home}#szolgaltatasok`, label: 'Szolgáltatások' },
  { href: `${home}#geppark`, label: 'Géppark' },
  { href: `${home}#referenciak`, label: 'Referenciák' },
  { href: `${base}/palyazat/`, label: 'Pályázat' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: company.legalName,
  description: company.tagline,
  telephone: company.phone,
  email: company.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Meder u. 26.',
    postalCode: '3300',
    addressLocality: 'Eger',
    addressCountry: 'HU',
  },
  geo: { '@type': 'GeoCoordinates', latitude: company.geo.lat, longitude: company.geo.lng },
  url: 'https://sebikft.hu/',
};
---
<!doctype html>
<html lang="hu" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e1418" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="hu_HU" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>
  <body>
    <a class="skip-link" href="#tartalom">Ugrás a tartalomra</a>

    <header class:list={['site-header', { 'always-solid': solidHeader }]} data-header>
      <div class="container">
        <a class="brand" href={home} aria-label={`${company.name} – kezdőlap`}>
          <BrandMark />
          <span class="brand-text">
            <span class="brand-name">SEBI</span>
            <span class="brand-sub">CNC alkatrészgyártás</span>
          </span>
        </a>
        <button class="nav-toggle" aria-label="Menü" aria-expanded="false" aria-controls="nav" data-nav-toggle>
          <Icon name="menu" size={28} />
        </button>
        <nav class="nav" id="nav" data-nav>
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <a class="btn btn-primary" href={`${home}#kapcsolat`}>Ajánlatkérés</a>
        </nav>
      </div>
    </header>

    <main id="tartalom">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <a class="brand" href={home} style="color:#fff">
              <BrandMark />
              <span class="brand-text">
                <span class="brand-name">SEBI</span>
                <span class="brand-sub">CNC alkatrészgyártás</span>
              </span>
            </a>
            <p style="margin-top:16px;max-width:36ch">{company.tagline} Egerben.</p>
          </div>
          <div>
            <h4>Elérhetőség</h4>
            <ul>
              <li><a href={company.phoneHref}>{company.phone}</a></li>
              <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
              <li>{company.site}</li>
            </ul>
          </div>
          <div>
            <h4>Oldalak</h4>
            <ul>
              {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
              <li><a href={`${base}/adatvedelem/`}>Adatvédelem</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} {company.legalName}</span>
          <a class="sz2020" href={`${base}/palyazat/`}>
            <span class="sz2020-flag" aria-hidden="true"></span>
            <span>Széchenyi 2020<br /><span style="font-weight:500">Támogatott projekt</span></span>
          </a>
        </div>
      </div>
    </footer>

    <script>
      const header = document.querySelector<HTMLElement>('[data-header]');
      const onScroll = () => header?.classList.toggle('is-solid', window.scrollY > 40);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const nav = document.querySelector<HTMLElement>('[data-nav]');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('is-open') ?? false;
        toggle.setAttribute('aria-expanded', String(open));
      });
      nav?.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          nav.classList.remove('is-open');
          toggle?.setAttribute('aria-expanded', 'false');
        }),
      );

      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
